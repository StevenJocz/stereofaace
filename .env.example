# Copia a .env.local (nunca subas .env.local ni secretos al repositorio).

# PostgreSQL real. Sin esta variable, en desarrollo se usa PGlite (.data/pglite).
# DATABASE_URL=postgres://stereoface:CAMBIA_ESTO@localhost:5432/stereoface

# Hosts adicionales permitidos para reproductores oficiales incrustados de la radio (separados por comas).
# Solo añade proveedores cuyo reproductor oficial tengas permiso de integrar.
# RADIO_EMBED_HOSTS=player.proveedor.example
