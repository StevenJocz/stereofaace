# Copia a .env.local (nunca subas .env.local ni secretos al repositorio).

# PostgreSQL real. Sin esta variable, en desarrollo se usa PGlite (.data/pglite).
# DATABASE_URL=postgres://stereoface:CAMBIA_ESTO@localhost:5432/stereoface

# Hosts adicionales permitidos para reproductores oficiales incrustados de la radio (separados por comas).
# Solo añade proveedores cuyo reproductor oficial tengas permiso de integrar.
# RADIO_EMBED_HOSTS=player.proveedor.example

# ── Cámara en cabina (video del locutor → YouTube Live). Ver DEPLOY.md, «Cámara en cabina». NUNCA pongas valores reales aquí.
# Credenciales OAuth de Google Cloud (tipo «Aplicación web»).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Opcional: por defecto es NEXT_PUBLIC_SITE_URL + /api/youtube/oauth/callback (debe coincidir con la consola de Google).
# GOOGLE_REDIRECT_URI=
# Clave de 32 bytes que cifra el refresh token en la base de datos:  openssl rand -base64 32
# VIDEO_SECRET_KEY=
# LiveKit Cloud (proyecto propio de StereoFace): el video no pasa por el servidor, que no necesita IP pública.
# LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
